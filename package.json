{
  "name": "anyhour",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:worker": "bun run --cwd packages/api worker",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run --filter '*' build",
