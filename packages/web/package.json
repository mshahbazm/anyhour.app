{
  "name": "@anyhour/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src",
    "format": "prettier --write src index.html vite.config.ts package.json tsconfig.json tsr.config.json eslint.config.js prettier.config.js && eslint . --fix",
    "format:check": "prettier --check src index.html vite.config.ts package.json tsconfig.json tsr.config.json eslint.config.js prettier.config.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/router-plugin": "1.168.41",
    "@anyhour/widget": "workspace:*",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.39",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
