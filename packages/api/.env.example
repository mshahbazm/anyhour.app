DATABASE_URL=postgresql://postgres:postgres@localhost:5432/websiteplus
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
FRONT_END_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Website Plus <login@example.com>"
# AI providers (docs/aiProviders.md). Keys belong to a vendor: one variable
# each. Each capability picks a provider: LLM_PROVIDER for text, objects,
# embeddings and images (openai), DECISION_PROVIDER for typed judgments such
# as page cleanup (openai or typesafe). The API refuses to start when a
# selected provider's vendor key is missing. Models live in
# src/config/models.config.ts, not here.
OPENAI_API_KEY=
LLM_PROVIDER=openai
DECISION_PROVIDER=openai
# Only needed with DECISION_PROVIDER=typesafe. TYPESAFE_API_URL optionally
# points at another TypeSafe endpoint.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Team chat apps (docs/teamChat.md). Leave empty to hide Slack: its card
# on My tools then says "Not available yet".
# Slack app: Basic Information → App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Customer WhatsApp through Meta's Cloud API (docs/customerWhatsapp.md).
# Leave empty to hide it. The app secret is in Meta's App settings → Basic;
# the verify token is any long random string, typed again in Meta's
# WhatsApp → Configuration → Webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
