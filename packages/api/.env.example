# Team chat apps (docs/teamChat.md). Leave empty to hide Slack: its card
# on My tools then says "Not available yet".
# Slack app: Basic Information → App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Customer WhatsApp through Meta's Cloud API (docs/customerWhatsapp.md).
# Leave empty to hide it. The app secret is in Meta's App settings → Basic;
# the verify token is any long random string, typed again in Meta's
# WhatsApp → Configuration → Webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
